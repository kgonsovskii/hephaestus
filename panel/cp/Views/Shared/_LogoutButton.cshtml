@using model
@inject IHttpContextAccessor HttpContextAccessor

<style>
    .build-stamp {
        position: fixed;
        top: 8px;
        right: 14px;
        z-index: 2000;
        font: 12px ui-monospace, Consolas, monospace;
        color: #6b7280;
        white-space: nowrap;
        pointer-events: none;
    }
</style>
<span class="build-stamp">@VersionFetcher.Version()</span>

@if (HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true)
{
    <div class="user-info">
        <table style="align-content: center; width: 90%; margin: 3px">
            <tr>
                <td>
                    Welcome, @HttpContextAccessor.HttpContext.User.Identity.Name!
                </td>
                <td>
                    <a href='@ViewData["UrlDoc"]' target="_blank">Goto Google Document</a>&nbsp;&nbsp;&nbsp;
                </td>
                <td>&nbsp;&nbsp;&nbsp;</td>
                <td>
                    <form method="post" action="Auth/logout">
                        <button type="submit" class="btn btn-link">Logout</button>
                    </form>
                </td>
            </tr>
        </table>
    </div>
    <hr/>
}